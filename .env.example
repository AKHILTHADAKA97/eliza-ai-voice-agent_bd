# =============================================================================
# ELIZA AI Backend Environment Configuration (Production Template)
# Never commit real secrets, API keys, or production passwords to version control.
# =============================================================================

APP_NAME="ELIZA AI"
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Security Settings
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=change-in-production-secret-key-32chars
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE_BYTES=1048576

# LLM Providers (Configure at least one)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# OpenAI-Compatible (vLLM, LocalAI, Groq, OpenRouter, etc.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Persistence & Database
MONGODB_URI=
MONGODB_DATABASE=eliza_ai
CONVERSATION_FILE=data/conversations.json

# Routing & Execution
DEFAULT_PROVIDER=ollama
REQUEST_TIMEOUT_SECONDS=180
